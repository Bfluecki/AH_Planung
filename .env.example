# --- Datenbank (Railway PostgreSQL-Plugin stellt DATABASE_URL bereit) ---
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ah_planung

# --- Bexio-Zugang: entweder statischer API-Token (einfach, empfohlen) ODER OAuth2 ---
# Statischer Token hat Vorrang, wenn gesetzt (siehe app/admin_config.py). Kann auch
# bequemer ueber die Admin-Seite (/admin) gesetzt werden, statt hier.
BEXIO_API_TOKEN=

# OAuth2 (nur noetig, falls BEXIO_API_TOKEN leer bleibt) - Developer-App unter
# https://developer.bexio.com registrieren:
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=
# Muss exakt der bei Bexio hinterlegten Redirect-URI entsprechen, z.B. https://<app>.up.railway.app/bexio/callback
BEXIO_REDIRECT_URI=http://localhost:8000/bexio/callback
BEXIO_API_BASE_URL=https://api.bexio.com
# idp.bexio.com wurde per 31.03.2025 abgeschaltet - neuer Login-Server:
BEXIO_AUTH_BASE_URL=https://auth.bexio.com/realms/bexio

# Komma-separierte Liste der angefragten Scopes (nur Lesezugriffe, Phase 1)
BEXIO_SCOPES=kb_offer_show,kb_order_show,kb_invoice_show,kb_credit_voucher_show,contact_show

# --- Planungslogik ---
# "prorata" (empfohlen) oder "full_month"
ALLOCATION_MODE=prorata
MONTHLY_BUDGET_CHF=28333.30
CURRENT_PLANNING_YEAR=2026

# --- App ---
SECRET_KEY=change-me-in-railway
LOG_LEVEL=INFO
SYNC_INTERVAL_MINUTES=60

# --- Erst-Admin (Seed) ---
# Beim allerersten Start (wenn noch keine Benutzer existieren) wird aus diesen
# beiden Werten automatisch ein Administrator-Konto angelegt. Danach werden
# Benutzer ueber die Admin-Seite verwaltet; diese Variablen sind dann nur noch
# fuer den Notfall-Seed relevant. Ohne ADMIN_PASSWORD wird kein Seed-Admin erstellt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SECRET_KEY (oben) signiert zusaetzlich die Login-Session-Cookies - in Railway
# unbedingt auf einen langen Zufallswert setzen.

# --- Automatisches Backup vor jedem Deploy (app/backup.py) ---
# Ziel ist ein S3-kompatibler Objektspeicher. Sind Bucket oder Zugangsdaten leer,
# wird das Backup uebersprungen und der Start der App trotzdem fortgesetzt.
# ACHTUNG: Das Backup enthaelt den kompletten Datenbestand inklusive Passwort-Hashes
# und Bexio-Zugangsdaten - der Bucket muss zwingend privat sein.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Leer lassen fuer AWS S3; sonst der Endpunkt des Anbieters, z.B.
# https://s3.eu-central-003.backblazeb2.com (Backblaze B2)
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=ah-planung
# Anzahl aufbewahrter Backups; aeltere werden nach dem Upload geloescht.
BACKUP_KEEP=20
# true = ein fehlgeschlagenes Backup bricht den Deploy ab. Default false, damit ein
# Ausfall des Speicheranbieters die App nie offline nimmt.
BACKUP_REQUIRED=false
