# --- Datenbank (Railway PostgreSQL-Plugin stellt DATABASE_URL bereit) ---
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ah_planung

# --- Bexio OAuth2 (Developer-App unter https://developer.bexio.com registrieren) ---
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=
# Muss exakt der bei Bexio hinterlegten Redirect-URI entsprechen, z.B. https://<app>.up.railway.app/bexio/callback
BEXIO_REDIRECT_URI=http://localhost:8000/bexio/callback
BEXIO_API_BASE_URL=https://api.bexio.com
BEXIO_AUTH_BASE_URL=https://idp.bexio.com

# Komma-separierte Liste der angefragten Scopes (nur Lesezugriffe, Phase 1)
BEXIO_SCOPES=kb_offer_show,kb_order_show,kb_invoice_show,kb_credit_voucher_show,contact_show

# --- Planungslogik ---
# "prorata" (empfohlen) oder "full_month"
ALLOCATION_MODE=prorata
MONTHLY_BUDGET_CHF=28333.30
CURRENT_PLANNING_YEAR=2026

# --- App ---
SECRET_KEY=change-me-in-railway
LOG_LEVEL=INFO
SYNC_INTERVAL_MINUTES=60
